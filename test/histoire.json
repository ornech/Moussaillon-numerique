    {
      "collectionId": "pbc_activites_01",
      "collectionName": "activites",
      "contenu": "<h3>L'invention de l'écriture</h3><p>L'Antiquité commence avec l'apparition de l'écriture vers <b>3500 av. J.-C.</b> en Mésopotamie. C'est la fin de la Préhistoire.</p><ul><li><b>En Mésopotamie :</b> On écrit sur des tablettes d'argile avec des signes en forme de clous (l'écriture <b>cunéiforme</b>).</li><li><b>En Égypte :</b> On utilise des <b>hiéroglyphes</b> (dessins stylisés).</li><li><b>Les Scribes :</b> Ce sont les spécialistes de l'écriture dans l'Antiquité.</li></ul>",
      "id": "antiquite_ecriture_001",
      "quiz_json": [
        {
          "question": "Quel événement marque le passage de la Préhistoire à l'Histoire ?",
          "options": [
            "La découverte du feu",
            "L'invention de l'écriture",
            "La construction des pyramides",
            "L'invention de la roue"
          ],
          "reponse": "L'invention de l'écriture"
        },
        {
          "question": "Vers quelle année l'écriture a-t-elle été inventée ?",
          "options": [
            "800 av. J.-C.",
            "1500 av. J.-C.",
            "3500 av. J.-C.",
            "2000 ap. J.-C."
          ],
          "reponse": "3500 av. J.-C."
        },
        {
          "question": "Comment appelle-t-on l'écriture des anciens Égyptiens ?",
          "options": [
            "L'alphabet",
            "Les hiéroglyphes",
            "Le cunéiforme",
            "Le latin"
          ],
          "reponse": "Les hiéroglyphes"
        },
        {
          "question": "Sur quel support écrivait-on en Mésopotamie ?",
          "options": [
            "Des feuilles de papier",
            "Des tablettes d'argile",
            "Des écrans numériques",
            "Des plaques de métal"
          ],
          "reponse": "Des tablettes d'argile"
        },
        {
          "question": "Comment appelle-t-on l'écriture en forme de « coins » ?",
          "options": [
            "Cunéiforme",
            "Calligraphie",
            "Scribouille",
            "Hiéroglyphe"
          ],
          "reponse": "Cunéiforme"
        },
        {
          "question": "Comment s'appelle le spécialiste qui écrit dans l'Antiquité ?",
          "options": [
            "Un écrivain",
            "Un scribe",
            "Un prophète",
            "Un druide"
          ],
          "reponse": "Un scribe"
        },
        {
          "question": "À quoi servait principalement l'écriture au début ?",
          "options": [
            "À envoyer des messages",
            "À compter les récoltes et impôts",
            "À dessiner",
            "À créer des chansons"
          ],
          "reponse": "À compter les récoltes et impôts"
        },
        {
          "question": "Où l'écriture est-elle apparue pour la première fois ?",
          "options": [
            "En France",
            "En Amérique",
            "En Mésopotamie",
            "En Chine"
          ],
          "reponse": "En Mésopotamie"
        },
        {
          "question": "L'Antiquité est la période qui suit immédiatement...",
          "options": [
            "Le Moyen Âge",
            "La Préhistoire",
            "L'Époque Moderne",
            "Le Futur"
          ],
          "reponse": "La Préhistoire"
        },
        {
          "question": "L'outil utilisé pour écrire dans l'argile s'appelle...",
          "options": [
            "Un calame",
            "Un stylo",
            "Un pinceau",
            "Une craie"
          ],
          "reponse": "Un calame"
        }
      ],
      "rubrique": "L’Antiquité",
      "titre": "L’invention de l’écriture",
      "univers": "Histoire"
    },
    {
      "collectionId": "pbc_activites_01",
      "collectionName": "activites",
      "contenu": "<h3>Les Gaulois : de grands inventeurs</h3><p>Les Gaulois étaient des agriculteurs et des artisans très doués.</p><ul><li><b>Inventions :</b> Le <b>tonneau</b> et le <b>savon</b>.</li><li><b>Habitations :</b> Les villes fortifiées s'appellent des <b>oppidums</b>.</li><li><b>Religion :</b> Les <b>druides</b> s'occupaient du culte.</li></ul>",
